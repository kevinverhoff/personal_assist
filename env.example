# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- Google OAuth2 (installed-app flow), Gmail read-only ---
# One-time setup: register an OAuth client in Google Cloud Console, run the
# local consent flow once to get a refresh token, then paste it here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Gemini API, used for message classification ---
GEMINI_API_KEY=

# --- Notion, same integration token used for the People/Organizations workspace ---
NOTION_TOKEN=
NOTION_PEOPLE_DATA_SOURCE_ID=fb899c66-9550-4ea3-86df-2813775a6a73
NOTION_ORGANIZATIONS_DATA_SOURCE_ID=564bc543-d2a0-4e02-a907-6782a08ce363
NOTION_AFFILIATIONS_DATA_SOURCE_ID=9c5cf301-fbe9-4ca6-a630-ba6f93554e32
NOTION_EMAIL_ADDRESSES_DATA_SOURCE_ID=fc7a5711-63f5-4521-b9a4-d64c50681292

# --- Local storage (Phase 1 runs entirely on your machine, no Cloudflare yet) ---
# Created automatically on first run if the path doesn't exist.
DB_PATH=./data/email_agent.db

# --- Local human-readable run log (the "notepad" log) ---
LOG_PATH=./logs/agent_log.md
